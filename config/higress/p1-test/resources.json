    {
        "apiVersion":  "extensions.higress.io/v1alpha1",
        "kind":  "WasmPlugin",
        "metadata":  {
                         "name":  "p1-ext-auth",
                         "namespace":  "higress-system"
                     },
        "spec":  {
                     "phase":  "AUTHN",
                     "priority":  360,
                     "failStrategy":  "FAIL_CLOSE",
                     "url":  "http://localhost:8002/plugins/ext-auth/2.0.1/plugin.wasm",
                     "defaultConfigDisable":  false,
                     "defaultConfig":  {
                                           "failure_mode_allow":  false,
                                           "status_on_error":  403,
                                           "http_service":  {
                                                                "endpoint_mode":  "forward_auth",
                                                                "endpoint":  {
                                                                                 "service_name":  "p1-mapper.internal.static",
                                                                                 "service_port":  8081,
                                                                                 "path":  "/authorize",
                                                                                 "request_method":  "POST"
                                                                             },
                                                                "timeout":  500,
                                                                "authorization_request":  {
                                                                                              "allowed_headers":  [
                                                                                                                      {
                                                                                                                          "exact":  "x-mse-consumer"
                                                                                                                      }
                                                                                                                  ],
                                                                                              "headers_to_add":  {
                                                                                                                     "x-p1-mapper-request":  "p1-ext-auth"
                                                                                                                 }
                                                                                          },
                                                                "authorization_response":  {
                                                                                               "allowed_upstream_headers":  [
                                                                                                                                {
                                                                                                                                    "exact":  "authorization"
                                                                                                                                }
                                                                                                                            ],
                                                                                               "allowed_client_headers":  [

                                                                                                                          ]
                                                                                           }
                                                            }
                                       },
                     "matchRules":  [
                                        {
                                            "ingress":  [
                                                            "p1-ai-gateway-test"
                                                        ],
                                            "configDisable":  false,
                                            "config":  {
                                                           "failure_mode_allow":  false,
                                                           "status_on_error":  403,
                                                           "http_service":  {
                                                                                "endpoint_mode":  "forward_auth",
                                                                                "endpoint":  {
                                                                                                 "service_name":  "p1-mapper.internal.static",
                                                                                                 "service_port":  8081,
                                                                                                 "path":  "/authorize",
                                                                                                 "request_method":  "POST"
                                                                                             },
                                                                                "timeout":  500,
                                                                                "authorization_request":  {
                                                                                                              "allowed_headers":  [
                                                                                                                                      {
                                                                                                                                          "exact":  "x-mse-consumer"
                                                                                                                                      }
                                                                                                                                  ],
                                                                                                              "headers_to_add":  {
                                                                                                                                     "x-p1-mapper-request":  "p1-ext-auth"
                                                                                                                                 }
                                                                                                          },
                                                                                "authorization_response":  {
                                                                                                               "allowed_upstream_headers":  [
                                                                                                                                                {
                                                                                                                                                    "exact":  "authorization"
                                                                                                                                                }
                                                                                                                                            ],
                                                                                                               "allowed_client_headers":  [

                                                                                                                                          ]
                                                                                                           }
                                                                            }
                                                       }
                                        }
                                    ]
                 }
    },
    {
        "apiVersion":  "extensions.higress.io/v1alpha1",
        "kind":  "WasmPlugin",
        "metadata":  {
                         "name":  "p1-ai-proxy",
                         "namespace":  "higress-system"
                     },
        "spec":  {
                     "priority":  100,
                     "failStrategy":  "FAIL_CLOSE",
                     "url":  "http://localhost:8002/plugins/ai-proxy/2.0.1/plugin.wasm",
                     "defaultConfigDisable":  false,
                     "defaultConfig":  {
