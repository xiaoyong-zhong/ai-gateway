[
    {
        "apiVersion":  "networking.higress.io/v1",
        "kind":  "McpBridge",
        "metadata":  {
                         "name":  "default",
                         "namespace":  "higress-system"
                     },
        "spec":  {
                     "registries":  [
                                        {
                                            "name":  "p1-litellm.internal",
                                            "domain":  "172.30.53.2:4000",
                                            "port":  80,
                                            "protocol":  "http",
                                            "type":  "static"
                                        },
                                        {
                                            "name":  "p1-mapper.internal",
                                            "domain":  "172.30.53.4:8081",
                                            "port":  8081,
                                            "protocol":  "http",
                                            "type":  "static"
                                        }
                                    ]
                 }
    },
    {
        "apiVersion":  "networking.k8s.io/v1",
        "kind":  "Ingress",
        "metadata":  {
                         "name":  "p1-ai-gateway-test",
                         "namespace":  "higress-system",
                         "annotations":  {
                                             "higress.io/destination":  "p1-litellm.internal.static:80",
                                             "higress.io/enable-proxy-next-upstream":  "false"
                                         }
                     },
        "spec":  {
                     "ingressClassName":  "higress",
                     "rules":  [
                                   {
                                       "host":  "ai-gateway-p1-test.local",
                                       "http":  {
                                                    "paths":  [
                                                                  {
                                                                      "path":  "/v1",
                                                                      "pathType":  "Prefix",
                                                                      "backend":  {
                                                                                      "resource":  {
                                                                                                       "apiGroup":  "networking.higress.io",
                                                                                                       "kind":  "McpBridge",
                                                                                                       "name":  "default"
                                                                                                   }
                                                                                  }
                                                                  }
                                                              ]
                                                }
                                   }
                               ]
                 }
    },
    {
        "apiVersion":  "extensions.higress.io/v1alpha1",
        "kind":  "WasmPlugin",
        "metadata":  {
                         "name":  "p1-strip-client-internal",
                         "namespace":  "higress-system"
                     },
        "spec":  {
                     "phase":  "AUTHN",
                     "priority":  600,
                     "failStrategy":  "FAIL_CLOSE",
                     "url":  "http://localhost:8002/plugins/transformer/2.0.1/plugin.wasm",
                     "defaultConfigDisable":  false,
                     "defaultConfig":  {
                                           "reroute":  false,
                                           "reqRules":  [
                                                            {
                                                                "operate":  "remove",
                                                                "headers":  [
                                                                                {
                                                                                    "key":  "X-Mse-Consumer"
                                                                                },
                                                                                {
                                                                                    "key":  "x-hi-original-auth"
                                                                                },
                                                                                {
                                                                                    "key":  "x-p1-litellm-key"
                                                                                },
                                                                                {
                                                                                    "key":  "x-p1-application-id"
                                                                                },
                                                                                {
                                                                                    "key":  "x-p1-mapper-request"
                                                                                }
                                                                            ]
                                                            }
                                                        ]
                                       },
                     "matchRules":  [
                                        {
                                            "ingress":  [
                                                            "p1-ai-gateway-test"
                                                        ],
                                            "configDisable":  false,
                                            "config":  {
                                                           "reroute":  false,
                                                           "reqRules":  [
                                                                            {
                                                                                "operate":  "remove",
                                                                                "headers":  [
                                                                                                {
                                                                                                    "key":  "X-Mse-Consumer"
                                                                                                },
                                                                                                {
                                                                                                    "key":  "x-hi-original-auth"
                                                                                                },
                                                                                                {
                                                                                                    "key":  "x-p1-litellm-key"
                                                                                                },
                                                                                                {
                                                                                                    "key":  "x-p1-application-id"
                                                                                                },
                                                                                                {
                                                                                                    "key":  "x-p1-mapper-request"
                                                                                                }
                                                                                            ]
                                                                            }
                                                                        ]
                                                       }
                                        }
                                    ]
                 }
    },
    {
